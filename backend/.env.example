# Optional. When unset, DocuLens answers from retrieved passages only.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# local | openai | sentence-transformers
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small

# Comma-separated origins in addition to localhost.
CORS_ORIGINS=

# sqlite file path, relative to the backend directory or absolute
DATABASE_URL=sqlite:///./data/doculens.db
